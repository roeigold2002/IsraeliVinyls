# Project V - Netlify Production Environment Template
# Site: israeli-vinyls-projectv
# URL:  https://israeli-vinyls-projectv.netlify.app

# -----------------------------------------------------------------------------
# Frontend / Vite
# -----------------------------------------------------------------------------
# Keep this set to the production origin so browser API calls target Netlify.
VITE_API_BASE_URL=https://israeli-vinyls-projectv.netlify.app

# Legacy fallback variable (optional). Keep equal to VITE_API_BASE_URL if used.
VITE_API_URL=https://israeli-vinyls-projectv.netlify.app

# -----------------------------------------------------------------------------
# Netlify Function API CORS
# -----------------------------------------------------------------------------
# Comma-separated allowlist used by netlify/functions/api.cjs.
# Include production origin and local dev origins.
CORS_ALLOWED_ORIGINS=https://israeli-vinyls-projectv.netlify.app,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Canonical production site URL used by API defaults.
PRODUCTION_SITE_URL=https://israeli-vinyls-projectv.netlify.app

# -----------------------------------------------------------------------------
# Build Runtime
# -----------------------------------------------------------------------------
NODE_VERSION=20
NPM_FLAGS=--no-audit --no-fund

# -----------------------------------------------------------------------------
# Optional: Python Scheduler / External Worker Runtime
# -----------------------------------------------------------------------------
# These are optional unless you run app.py + scheduler_service.py outside Netlify.

# Python executable used by scheduler_service.py
PYTHON_BIN=python

# Node executable used by scheduler_service.py for true-up worker
NODE_BIN=node

# Enable incremental true-up after daily ingest/export cycle
TRUEUP_AFTER_DAILY=true

# Run standalone incremental true-up cycle every N minutes in app.py scheduler
TRUEUP_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# Optional: Ingestion tuning (scheduler_service.py)
# -----------------------------------------------------------------------------
INGEST_STRICT=1
INGEST_TIMEOUT=10
INGEST_WORKERS=5
INGEST_MAX_PAGES_PER_STORE=35
INGEST_MAX_CRAWL_DEPTH=2
INGEST_REQUIRE_QUERY_MATCH=0

# -----------------------------------------------------------------------------
# Optional: True-up worker tuning (scripts/trueup_worker.cjs)
# -----------------------------------------------------------------------------
TRUEUP_BATCH_SIZE=180
TRUEUP_CONCURRENCY=6
TRUEUP_TIMEOUT_MS=5000
TRUEUP_RETRIES=1
TRUEUP_MAX_ATTEMPTS=6
TRUEUP_RETRY_BASE_MS=20000
TRUEUP_SAVE_EVERY=60

# Comma-separated proxy templates. Supports {url} (encoded) and {url_raw} (without protocol).
TRUEUP_PROXY_TEMPLATES=https://r.jina.ai/http://{url_raw}

TRUEUP_USE_HEADLESS=true
TRUEUP_MAX_HEADLESS=8
TRUEUP_REBUILD_QUEUE=false
TRUEUP_AUDIT_ALL_PRICES=true
TRUEUP_FORCE_PRICE_REFRESH=false
TRUEUP_REFRESH_SNAPSHOT=false

# -----------------------------------------------------------------------------
# Netlify Dashboard - Required minimum set
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL
# CORS_ALLOWED_ORIGINS
# PRODUCTION_SITE_URL
# NODE_VERSION
