# Asset-Finder Environment Configuration Template
# Copy this file to E:\Asset-Finder\.env and update values

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://[user[:password]@][host][:port][/dbname][?param=value]
# Examples:
#   Local: postgresql://localhost/vinyl_records
#   With auth: postgresql://user:password@db.example.com:5432/vinyl_records
#   Production: postgresql://user:supestrong@db.prod.aws.com:5432/vinyl_records
DATABASE_URL=postgresql://localhost/vinyl_records

# ============================================================================
# DISCOGS API CONFIGURATION (Optional)
# ============================================================================

# Discogs personal access token for higher rate limits
# Get one at: https://www.discogs.com/settings/developers
# Leave blank for public API rate limit (25 req/min, 1 req/sec)
# With token: 60 req/min, 1 req/sec
DISCOGS_USER_TOKEN=

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# API server port (must not be in use)
# Common alternatives: 3000, 3002, 5000, 8000
API_PORT=3001

# API server host (0.0.0.0 = accessible from any IP)
# Use 127.0.0.1 for localhost only
API_HOST=0.0.0.0

# API log level: debug, info, warn, error
API_LOG_LEVEL=info

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend API URL (point to your API server)
# During development: http://localhost:3001
# Production: https://your-api-domain.com (with HTTPS)
VITE_API_URL=http://localhost:3001

# ============================================================================
# STORE CONFIGURATION (Advanced)
# ============================================================================

# Override default store configuration with JSON
# This is useful for:
# - Disabling stores temporarily
# - Testing custom URLs
# - Regional deployments
# 
# Format: JSON array of store config objects
# Each object needs: id, name, website (and optionally: enabled, adapterType)
# 
# UNCOMMENT and modify to use:
# VINYL_STORE_CONFIG=[
#   {
#     "id": "beatnik",
#     "enabled": true,
#     "website": "https://www.beatnik.co.il/"
#   },
#   {
#     "id": "shablool",
#     "enabled": false
#   }
# ]

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Node environment: development, production, test
NODE_ENV=development

# Enable CORS (for cross-origin requests)
# Set to your frontend domain for production
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# OPTIONAL MONITORING & ANALYTICS
# ============================================================================

# NewRelic APM monitoring (optional)
# NEW_RELIC_LICENSE_KEY=

# Sentry error tracking (optional)
# SENTRY_DSN=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Set to any value to enable debug logging
# DEBUG=*

# Disable SSL verification for development (HTTP only, UNSAFE for production)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================================================
# EXAMPLES
# ============================================================================

# Example 1: Local Development
# DATABASE_URL=postgresql://localhost/vinyl_records
# DISCOGS_USER_TOKEN=
# API_PORT=3001
# VITE_API_URL=http://localhost:3001

# Example 2: Docker Compose
# DATABASE_URL=postgresql://postgres:password@postgres-db:5432/vinyl_records
# API_PORT=3001
# VITE_API_URL=http://localhost:3001

# Example 3: Production (AWS)
# DATABASE_URL=postgresql://admin:SecurePass123@vinyl-db-prod.c9akciq32.us-east-1.rds.amazonaws.com:5432/vinyl_records
# DISCOGS_USER_TOKEN=your_discogs_token_from_settings
# NODE_ENV=production
# API_PORT=3001
# CORS_ORIGIN=https://vinyl-search.example.com
# VITE_API_URL=https://api.vinyl-search.example.com

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================
# 1. Ensure PostgreSQL is running and accessible
# 2. Update DATABASE_URL with your connection string
# 3. (Optional) Add DISCOGS_USER_TOKEN if you have one
# 4. Set NODE_ENV=development for local dev
# 5. Save as E:\Asset-Finder\.env
# 6. Run: cd E:\Asset-Finder && pnpm dev
# 7. Access: http://localhost:5173

# ============================================================================
# TROUBLESHOOTING
# ============================================================================
# Q: "ECONNREFUSED 127.0.0.1:5432"
# A: PostgreSQL not running. Start with: postgres -D /path/to/data

# Q: "connect ECONNREFUSED"
# A: Check DATABASE_URL is correct. Test with: psql "$DATABASE_URL"

# Q: "Port 3001 already in use"
# A: Change API_PORT to unused port (3002, 3003, etc.)

# Q: "CORS error in browser"
# A: Ensure CORS_ORIGIN matches your frontend URL

# Q: "Discogs results not appearing"
# A: API rate limit hit (wait 1 min) or token disabled (check settings)
