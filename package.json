{
  "name": "vinyl-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/api.cjs & vite",
    "export:snapshot": "python -m scripts.export_snapshot || python3 -m scripts.export_snapshot",
    "ingest:all": "python -m scripts.ingest_all_stores || python3 -m scripts.ingest_all_stores",
    "verify:coverage": "python -m scripts.verify_store_coverage || python3 -m scripts.verify_store_coverage",
    "snapshot:refresh": "npm run export:snapshot && npm run verify:coverage",
    "build": "npm run export:snapshot && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
