{
  "name": "vinyl-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/api.cjs & vite",
    "dev:e2e": "node server/api.cjs & vite --host 127.0.0.1 --port 5173",
    "export:snapshot": "python -m scripts.export_snapshot || python3 -m scripts.export_snapshot",
    "ingest:all": "python -m scripts.ingest_all_stores || python3 -m scripts.ingest_all_stores",
    "verify:coverage": "python -m scripts.verify_store_coverage || python3 -m scripts.verify_store_coverage",
    "verify:snapshot-integrity": "node scripts/verify_snapshot_integrity.cjs",
    "verify:api-contract": "node scripts/verify_api_contract.cjs",
    "synthetic:check": "node scripts/synthetic_checks.cjs",
    "rollout:staged": "node scripts/staged_rollout.cjs --policy rollout/rollout-policy.json",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:integration": "node --test tests/integration/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "qa:gate": "npm run export:snapshot && npm run verify:snapshot-integrity && npm run test:unit && npm run test:integration && npm run verify:api-contract && npm run test:e2e:ci && npm run build",
    "snapshot:refresh": "npm run export:snapshot && npm run verify:coverage && npm run verify:api-contract",
    "build": "npm run export:snapshot && npm run verify:api-contract && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
